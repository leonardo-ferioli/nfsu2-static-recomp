build raw_resource_tests.exe: CXX_EXECUTABLE_LINKER__raw_resource_tests_Release CMakeFiles/raw_resource_tests.dir/resource_tests.cpp.obj | nfsu2_raw.lib sleigh_runtime.lib || nfsu2_raw.lib sleigh_runtime.lib
  CONFIG = Release
  FLAGS = -m32 -msse2 -O3 -DNDEBUG -D_DLL -D_MT -Xclang --dependent-lib=msvcrt
  LINK_FLAGS = -Xlinker /subsystem:console -fuse-ld=lld -Wl,/BASE:0x00400000 -Wl,/DYNAMICBASE:NO -Wl,/LARGEADDRESSAWARE:NO -Wl,/SAFESEH:NO "-Wl,/sectionlayout:@C:/Users/Leonardo/Projects/NFSU2 REINGENIER/raw_recomp/native32_sections.txt" -fuse-ld=lld
  LINK_LIBRARIES = nfsu2_raw.lib  -lbcrypt.lib  -luser32.lib  -lwinmm.lib  sleigh_runtime.lib  -lkernel32 -luser32 -lgdi32 -lwinspool -lshell32 -lole32 -loleaut32 -luuid -lcomdlg32 -ladvapi32 -loldnames
  OBJECT_DIR = CMakeFiles\raw_resource_tests.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = CMakeFiles\raw_resource_tests.dir\
  TARGET_FILE = raw_resource_tests.exe
  TARGET_IMPLIB = raw_resource_tests.lib
  TARGET_PDB = raw_resource_tests.pdb
  TARGET_SUPPORT_DIR = CMakeFiles\raw_resource_tests.dir


